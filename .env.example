# MongoDB connection string (Atlas or self-hosted)
# e.g. mongodb+srv://user:pass@cluster0.mongodb.net/ecole-bilan
MONGODB_URI=mongodb://localhost:27017/ecole-bilan

# NextAuth
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change-this-to-something-random
NEXTAUTH_URL=http://localhost:3000

# Optional: real email delivery via SMTP (Resend, SendGrid, Gmail, etc.)
# Leave blank to keep "Send" actions simulated (safe for trying the app out).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=payroll@ecolebilan.cm
